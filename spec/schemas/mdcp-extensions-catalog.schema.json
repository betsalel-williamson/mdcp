{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/betsalel-williamson/mdcp/spec/schemas/mdcp-extensions-catalog.schema.json",
  "title": "MDCP extensions catalog",
  "description": "Root catalog at spec/extensions/manifest.json",
  "type": "object",
  "required": ["catalogVersion", "extensions"],
  "properties": {
    "catalogVersion": { "type": "string" },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/extensionEntry" }
    }
  },
  "$defs": {
    "extensionEntry": {
      "type": "object",
      "required": ["id", "description", "tags", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/versionEntry" }
        }
      }
    },
    "versionEntry": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string" },
        "protocolVersionRange": { "type": "string" },
        "minProtocolVersion": { "type": "string" },
        "maxProtocolVersion": { "type": "string" },
        "revoked": { "type": "boolean", "default": false },
        "revokedReason": { "type": "string" }
      },
      "oneOf": [{ "required": ["protocolVersionRange"] }, { "required": ["minProtocolVersion"] }]
    }
  }
}
