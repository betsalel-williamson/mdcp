{
  "name": "mdcp-monorepo",
  "private": true,
  "description": "MDCP — Markdown Command Line Interface Processor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/mdcp.git"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vale:sync": "mkdir -p examples/sample-guides/styles docs/styles && (cd examples/sample-guides && vale sync) && (cd docs && vale sync)",
    "verify:peers": "node_modules/.bin/markdownlint-cli2 --version && vale --version",
    "prepare:docs": "pnpm run verify:peers && pnpm run vale:sync",
    "docs:compile:repo": "node packages/mdcp-cli/dist/cli.js compile --config docs/mdcp.config.json --cwd docs",
    "docs:check:repo": "node packages/mdcp-cli/dist/cli.js check --config docs/mdcp.config.json --cwd docs --require-lint --require-vale",
    "docs:context": "node packages/mdcp-cli/dist/cli.js export --llm --stdout --config docs/mdcp.config.json --cwd docs",
    "docs:lint": "node packages/mdcp-cli/dist/cli.js lint --config examples/sample-guides/mdcp.config.json --cwd examples/sample-guides --require-lint",
    "docs:prose": "node packages/mdcp-cli/dist/cli.js prose --config examples/sample-guides/mdcp.config.json --cwd examples/sample-guides --require-vale",
    "docs:check:examples": "node packages/mdcp-cli/dist/cli.js check --config examples/sample-guides/mdcp.config.json --cwd examples/sample-guides --require-lint --require-vale",
    "docs:check": "pnpm run docs:check:repo && pnpm run docs:check:examples",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test && pnpm run docs:check",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "release:tag": "node scripts/release-tag.mjs",
    "release:tag:push": "node scripts/release-tag.mjs --push",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  },
  "lint-staged": {
    "packages/**/*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ],
    "eslint.config.mjs": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.28.0"
  }
}
