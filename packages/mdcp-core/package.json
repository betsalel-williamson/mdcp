{
  "name": "@mdcp/core",
  "version": "0.1.0",
  "description": "MDCP core library — compile, refs, validation",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/compile/hooks/builtin.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/mdcp.git",
    "directory": "packages/mdcp-core"
  },
  "bugs": {
    "url": "https://github.com/betsalel-williamson/mdcp/issues"
  },
  "homepage": "https://github.com/betsalel-williamson/mdcp/tree/main/packages/mdcp-core#readme",
  "keywords": [
    "markdown",
    "documentation",
    "compile",
    "refs",
    "validation"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
