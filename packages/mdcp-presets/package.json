{
  "name": "@bwilliamson/mdcp-presets",
  "version": "0.2.0",
  "description": "Starter markdownlint configs for MarkDown Context Protocol consumers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/mdcp.git",
    "directory": "packages/mdcp-presets"
  },
  "bugs": {
    "url": "https://github.com/betsalel-williamson/mdcp/issues"
  },
  "homepage": "https://github.com/betsalel-williamson/mdcp/tree/main/packages/mdcp-presets#readme",
  "keywords": [
    "markdown",
    "markdownlint",
    "mdcp",
    "presets"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "*.jsonc",
    "README.md"
  ],
  "exports": {
    "./markdownlint-shards.markdownlint-cli2.jsonc": "./markdownlint-shards.markdownlint-cli2.jsonc",
    "./markdownlint-compiled.markdownlint-cli2.jsonc": "./markdownlint-compiled.markdownlint-cli2.jsonc"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/validate-presets.mjs"
  }
}
