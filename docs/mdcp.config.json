{
  "protocol": {
    "profile": "alpha",
    "ref": "feature/issue-58-open-alpha-0.4"
  },
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "developer", "client-cli", "client-core"],
  "banner": "<!-- AUTO-GENERATED by mdcp — edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    { "name": "features", "compile": { "scopeRoot": "glossary" } },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../DEVELOPERS.md",
        "includeBanner": false,
        "crossGuideLinks": { "ignoreGuides": ["features"] }
      }
    },
    {
      "name": "client-cli",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-cli/README.md",
        "includeBanner": false,
        "crossGuideLinks": { "ignoreGuides": ["features"] }
      }
    },
    {
      "name": "client-core",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-core/README.md",
        "includeBanner": false,
        "crossGuideLinks": { "ignoreGuides": ["features"] }
      }
    }
  ],
  "refs": {
    "registryFile": ".caches/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../packages/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "compiled-lint.markdownlint-cli2.jsonc",
      "shardsGlobs": ["glossary", "features", "developer", "client-cli", "client-core"]
    },
    "xrefs": { "enabled": true }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": ["glossary", "features", "developer", "client-cli", "client-core"]
  },
  "export": {
    "llm": {
      "stripHtmlComments": true,
      "stripFrontmatter": true,
      "stripBanner": true,
      "collapseBlankLines": true
    }
  },
  "extensions": {
    "packs": [{ "id": "prompts-mdcp-defaults", "enabled": true, "version": "0.4.0.0" }]
  }
}
