{
  "$schema": "../packages/mdcp-core/mdcp.config.schema.json",
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": [
    "features",
    "developer",
    "client-cli",
    "client-core",
    "repo-readme",
    "presentation-la-devops"
  ],
  "banner": "<!-- AUTO-GENERATED by mdcp \u2014 edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../DEVELOPERS.md",
        "includeBanner": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-cli",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-cli/README.md",
        "includeBanner": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-core",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-core/README.md",
        "includeBanner": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "repo-readme",
      "compile": {
        "outputFile": "../../README.md",
        "includeBanner": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features", "client-cli", "developer"]
        }
      }
    },
    {
      "name": "presentation-la-devops",
      "compile": {
        "outputFile": "../../presentations/la-devops-2026.md",
        "includeBanner": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features", "client-cli", "developer", "repo-readme", "client-core"]
        }
      }
    }
  ],
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../packages/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "compiled-lint.markdownlint-cli2.jsonc",
      "shardsGlobs": [
        "glossary",
        "features",
        "developer",
        "client-cli",
        "client-core",
        "repo-readme",
        "presentation-la-devops"
      ]
    },
    "xrefs": {
      "enabled": true
    }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": [
      "glossary",
      "features",
      "developer",
      "client-cli",
      "client-core",
      "repo-readme",
      "presentation-la-devops"
    ]
  },
  "export": {
    "llm": {
      "stripHtmlComments": true,
      "stripFrontmatter": true,
      "stripBanner": true,
      "collapseBlankLines": true
    }
  }
}
