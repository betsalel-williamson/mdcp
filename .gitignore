# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/

# MDCP temp / cache
.compile-build/
.shard-work/
.caches/
*.llm.md

# Tooling auto-save / local state
.specstory/

# Test / typecheck artifacts
coverage/
*.tsbuildinfo

# Local IDE / indexing
.cursor/
.cursorindexingignore

# Agent Skills — local installs / workspaces (publishable source lives in skills/)
.agents/skills/mdcp/
.agents/skills/mdcp-arch-oss-library/
.agents/skills/mdcp-arch-product-docs-site/
.agents/skills/*-workspace/
skills/*-workspace/
# skill-creator is vendored (committed) for the local live-eval loop — do not gitignore
# but ignore its python cache artifacts
.agents/skills/skill-creator/**/__pycache__/
.agents/skills/skill-creator/**/*.pyc

# VS Code (keep shared workspace config)
.vscode/*

.tmp/

# Legacy generated reports
legacy/.cache/
legacy/anchors.json
legacy/vale-report.json

examples/sample-guides/styles/*
!examples/sample-guides/styles/.gitkeep

docs/styles/*
!docs/styles/.gitkeep

# MDCP compiled output (repo docs — regenerate with pnpm docs:compile:repo)
docs/_build/

# Rendered presentation artifacts — source lives in docs/presentation-la-devops/
build/presentations/
docs/presentation-la-devops/assets/*.png
docs/presentation-la-devops/assets/*.svg

# Sample guides fixture output
examples/sample-guides/_build/

# OS
.DS_Store

