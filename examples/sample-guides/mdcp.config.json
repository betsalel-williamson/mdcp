{
  "outputFile": "guides.md",
  "compileOrder": ["overview", "admin-guide", "developer-guide"],
  "banner": "<!-- AUTO-GENERATED by mdcp — edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    { "name": "overview" },
    { "name": "admin-guide" },
    { "name": "developer-guide" },
    {
      "name": "inserts-demo",
      "compile": {
        "hooks": ["inlineInserts"]
      }
    }
  ],
  "refs": {
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../../packages/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "../../packages/mdcp-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    },
    "xrefs": { "enabled": true }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": ["overview", "admin-guide", "developer-guide"]
  },
  "export": {
    "llm": {
      "stripHtmlComments": true,
      "stripFrontmatter": true,
      "stripBanner": true,
      "collapseBlankLines": true
    }
  }
}
