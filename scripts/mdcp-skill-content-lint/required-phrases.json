{
  "skillBodyMustInclude": [
    "mdcp compile",
    "mdcp check",
    "mdcp fix",
    "mdcp prose",
    "one shard",
    "complementary",
    "npx skills add",
    ".agents/skills/mdcp"
  ],
  "skillBodyMustNotInclude": [
    "MDCP: Compile Guides",
    "MDCP: Check Links",
    "VS Code Marketplace",
    "Open VSX",
    "scripts/lookup.sh",
    "refs lookup",
    "mdcp.v",
    "llms.txt"
  ],
  "hardRulesMustMention": [
    {
      "id": "no-hand-edit-skill",
      "patterns": ["hand-edit", ".agents/skills", "extensions"]
    },
    {
      "id": "no-monolith-dump",
      "patterns": ["monolith", "one shard"]
    },
    {
      "id": "no-edit-generated",
      "patterns": ["_build", "generated", "recompile"]
    },
    {
      "id": "docs-first",
      "patterns": ["docs-first", "shard", "functional"]
    },
    {
      "id": "always-check",
      "patterns": ["mdcp check", "docs:check"]
    },
    {
      "id": "no-temp-info",
      "patterns": ["temp info", "migration backlog", "planning", "issue tracking"]
    },
    {
      "id": "current-docs-only",
      "patterns": ["Current docs only", "as it works now", "changeset", "Git history"]
    },
    {
      "id": "small-batches",
      "patterns": ["Small batches", "one focused feature", "split the request"]
    },
    {
      "id": "no-code-in-docs",
      "patterns": ["No code in docs", "intent", "contracts", "implementation"]
    }
  ],
  "phraseScenarios": [
    {
      "id": "bootstrap",
      "prompt": "Bootstrap MDCP agent guidance in a new repo",
      "mustMention": ["skill", "npx skills add", "mdcp"]
    },
    {
      "id": "compile-check",
      "prompt": "Compile and validate docs after editing shards",
      "mustMention": ["mdcp compile", "mdcp check"]
    },
    {
      "id": "refs",
      "prompt": "Find a heading link while writing docs",
      "mustMention": ["mdcp check"]
    },
    {
      "id": "anti-monolith",
      "prompt": "Load documentation context for the agent",
      "mustMention": ["one shard"]
    },
    {
      "id": "anti-hand-edit-skill",
      "prompt": "Customize agent rules for this repo",
      "mustMention": ["complementary", "extensions"]
    },
    {
      "id": "remove-old-info",
      "prompt": "Remove old planning information from our docs, like the migration backlog",
      "mustMention": ["issue tracking", "planning", "temp info"]
    },
    {
      "id": "current-docs-stale",
      "prompt": "Behavior changed — should we keep the old docs section for history?",
      "mustMention": ["Current docs only", "changeset", "Git history"]
    },
    {
      "id": "small-batches-scope",
      "prompt": "User asked for five unrelated features in one branch — how should we scope the work?",
      "mustMention": ["Small batches", "one focused feature", "split the request"]
    },
    {
      "id": "no-code-in-shards",
      "prompt": "Should we paste the implementation into the feature shard?",
      "mustMention": ["No code in docs", "intent", "contracts"]
    }
  ]
}
