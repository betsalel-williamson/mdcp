{
  "aliveStatusCodes": [200, 206, 403, 429],
  "ignorePatterns": [
    { "pattern": "^#" },
    { "pattern": "^mailto:" },
    { "pattern": "^file:" },
    { "pattern": "^http://\\./" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^http://\\./",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "baseUrl": "file://{{CURDIR}}",
  "timeout": "30s",
  "retryOn429": true,
  "retryCount": 2
}
